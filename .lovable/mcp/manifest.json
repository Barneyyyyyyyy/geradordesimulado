  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://lmabeuihiupxuiryavmm.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "gerador-de-simulado",
      "version": "0.1.0",
      "title": "Gerador de Simulado"
    },
    "tools": [
      {
        "name": "list_simulados",
        "title": "Listar simulados",
        "description": "Lista os simulados do usuário autenticado, do mais recente para o mais antigo.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "description": "Quantos simulados retornar (padrão 20, máximo 100).",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_simulado",
        "title": "Detalhar simulado",
        "description": "Retorna um simulado do usuário com todas as suas questões, respostas e gabaritos.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "ID do simulado."
            }
          },
          "required": [
            "id"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "get_desempenho",
        "title": "Desempenho do estudante",
        "description": "Retorna o perfil, XP/nível/streak e um resumo de desempenho por área, banca e assunto do usuário autenticado.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      }
    ]
  }
